# Never commit real credentials. Copy this file to backend/.env and fill locally.
# The EXPO_PUBLIC_* aliases are supported only for migration; server-side names are preferred.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
NVIDIA_NIM_API_KEY=
COHERE_API_KEY=

# Optional OpenRouter attribution
OPENROUTER_HTTP_REFERER=http://localhost:5173
